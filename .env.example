# ---------------------------------------------------------------------------
# AGROBOTAI server configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- LAN server (start.bat binds to all interfaces; protect with the Windows Firewall, Private profile) ---
AGROBOT_PORT=8000
MAX_UPLOAD_MB=10
# Phones may create farmer accounts themselves. Admin accounts are only created on the laptop:
#   .venv\Scripts\python.exe manage_users.py create-admin
ALLOW_FARMER_SIGNUP=true
SESSION_DAYS=30

# --- Models ---
PEST_MODEL_PATH=models/pest_model.pt
DISEASE_MODEL_PATH=models/disease_model.pt
# Disease results below this calibrated confidence are reported as "uncertain"
DISEASE_UNCERTAIN_THRESHOLD=0.90

# --- Weather: Open-Meteo works without any key. Optional WeatherAPI.com key (https://www.weatherapi.com) ---
WEATHER_API_KEY=

# --- Sensor gateway (Raspberry Pi / ESP32). Shared secret sent in the X-Sensor-Token header. Empty = disabled ---
SENSOR_INGEST_TOKEN=
SENSOR_STALE_SECONDS=300

# --- Offline LLM advisor via Ollama (OpenAI-compatible API) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=agri-qwen:7b
OPENAI_TIMEOUT_SECONDS=60
# Model for farmer advice and chat in 12 languages (agri-qwen writes poor Tamil). Install: ollama pull gemma3:4b
ADVISOR_MODEL=gemma3:4b
# Raspberry Pi only: use the laptop's Ollama first, the Pi's own small model when the laptop is off:
#   OPENAI_BASE_URL=http://YOUR-LAPTOP-NAME.local:11434/v1
#   ADVISOR_FALLBACK_URL=http://127.0.0.1:11434
#   ADVISOR_FALLBACK_MODEL=gemma3:1b
ADVISOR_FALLBACK_URL=
ADVISOR_FALLBACK_MODEL=

# --- Heuristic health index weights (documented in the API response) ---
WEIGHT_PEST=0.30
WEIGHT_DISEASE=0.35
WEIGHT_NDRE=0.20
WEIGHT_CRI=0.15
STATUS_HEALTHY=80
STATUS_MILD=60
STATUS_MODERATE=40
LOW_CONFIDENCE_THRESHOLD=0.30
HIGH_CONFIDENCE_THRESHOLD=0.75
